{
    "name": "esp32-co2-tooling",
    "version": "0.0.0",
    "private": true,
    "description": "Linting/formatting for non-firmware files (Z2M converter, scripts)",
    "type": "module",
    "scripts": {
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "format": "biome format --write",
        "install-hooks": "git config core.hooksPath .githooks"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.11"
    }
}
